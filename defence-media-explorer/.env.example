# Local-only values. Copy to .env and fill in credentials. Never commit .env.
# Containers and the browser do not share a MinIO hostname.
# S3_ENDPOINT is the address the API and worker use (http://minio:9000 inside Compose).
# S3_PUBLIC_ENDPOINT is the address baked into signed URLs the browser can open
# (http://localhost:9000 on a laptop). Signing with the internal hostname makes
# the browser request fail even when the signature is valid.
# MinIO also needs a CORS rule that allows the frontend origin to PUT and GET.
# infra/minio-cors.json is applied by the minio-init service.

APP_ENV=development
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
DEFAULT_LOCALE=en-GB
SUPPORTED_LOCALES=it-IT,en-GB,fr-FR,es-ES,de-DE
DEFAULT_TIMEZONE=Europe/Rome

# MongoDB Atlas. The application database is defence_media_explorer.
# Do not point this at admin, local, or config.
MONGODB_URI=
MONGODB_DATABASE=defence_media_explorer
ATLAS_VECTOR_INDEX=segments_vector_v1
ATLAS_SEARCH_INDEX=segments_text_v1

# Voyage multimodal embeddings. input_type=document on ingest and query on search.
# output_dimension must match EMBEDDING_DIMENSIONS and the Atlas vector index.
# Voyage is not used for descriptions or transcription.
VOYAGE_API_KEY=
VOYAGE_MULTIMODAL_MODEL=voyage-multimodal-3.5
EMBEDDING_DIMENSIONS=1024
VOYAGE_RERANK_MODEL=rerank-3
# Text rerank does not see pixels. Leave false unless you want that optional pass.
ENABLE_RERANK=false
# Optional second text space. Leave false unless you want voyage-4-large as well.
# Those vectors are stored in textEmbedding and segments_text_vector_v1.
# They are never written into embedding and their scores are never added to the
# multimodal scores. Rank fusion is the only combination. Turning this on requires
# a reprocess of existing media and an index update.
ENABLE_TEXT_EMBEDDINGS=false
VOYAGE_TEXT_MODEL=voyage-4-large
TEXT_EMBEDDING_DIMENSIONS=1024
ATLAS_TEXT_VECTOR_INDEX=segments_text_vector_v1

# OpenAI vision descriptions, OCR, and speech-to-text.
# whisper-1 is the initial transcription model because segment timestamps are required.
# gpt-transcribe is the general file-transcription recommendation, but it is not the
# timestamped path this archive uses. Change TRANSCRIPTION_MODEL only deliberately.
OPENAI_API_KEY=
VISION_MODEL=gpt-4.1-mini
TRANSCRIPTION_MODEL=whisper-1

# Compose overrides REDIS_URL and S3_ENDPOINT for containers.
REDIS_URL=redis://redis:6379/0

S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=defence-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# At least 16 characters. Used to sign the session cookie.
SESSION_SECRET=
# Optional bootstrap admin. Leave blank to skip seeding. Password needs 10+ characters,
# a letter, and a digit. The seed runs once if the email is not already present.
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_WORKSPACE_ID=demo

MAX_UPLOAD_MB=1024
MAX_MEDIA_DURATION_SECONDS=7200
VIDEO_SEGMENT_SECONDS=10
VIDEO_SEGMENT_OVERLAP_SECONDS=2
VIDEO_MAX_KEYFRAMES_PER_SEGMENT=6
AUDIO_SEGMENT_SECONDS=30
AUDIO_SEGMENT_OVERLAP_SECONDS=2
TEXT_CHUNK_CHARS=1200
TEXT_CHUNK_OVERLAP_CHARS=200
INGESTION_CONCURRENCY=2
SEARCH_TOP_K=20
# numCandidates is the ANN pool before the limit. Raise it when filters are very selective.
VECTOR_NUM_CANDIDATES=400
RRF_K=60
DIRECT_UPLOAD_MAX_MB=64
PLAYBACK_URL_TTL_SECONDS=900
NEARBY_GAP_MS=2000
